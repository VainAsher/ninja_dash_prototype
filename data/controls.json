{
  "version": "1.0",
  "description": "Ninja Dash - Data-driven control configuration",
  "keyboard": {
    "movement": {
      "move_left": ["left", "a"],
      "move_right": ["right", "d"],
      "crouch_down": ["down", "s"],
      "jump": ["space", "up"]
    },
    "abilities": {
      "dash": ["lshift", "rshift"],
      "shadow_step": ["q"],
      "grapple": ["e"],
      "ground_pound": ["lctrl", "rctrl"],
      "air_dodge": ["x"],
      "slide": ["c"],
      "glide": ["hold:space"],
      "wall_cling": ["hold:left|right"],
      "time_slow": ["z"],
      "teleport": ["r"],
      "double_jump": ["space", "up"],
      "wall_jump": ["space", "up"]
    },
    "combat": {
      "melee_attack": ["j"],
      "ranged_attack": ["k"],
      "special_attack": ["l"],
      "block_parry": ["i"]
    },
    "ui": {
      "pause": ["escape"],
      "inventory": ["tab"],
      "map": ["m"],
      "quests": ["n"],
      "stats": ["p"],
      "controls_help": ["h"]
    },
    "debug": {
      "toggle_double_jump": ["f1"],
      "toggle_dash": ["f2"],
      "toggle_slide": ["f3"],
      "toggle_shadow_step": ["f4"],
      "toggle_wall_cling": ["f5"],
      "toggle_air_dodge": ["f6"],
      "toggle_glide": ["f7"],
      "toggle_sword_attack": ["f8"],
      "toggle_grapple": ["f9"],
      "toggle_debug_overlay": ["f10"],
      "toggle_hitboxes": ["f11"],
      "reload_level": ["f12"]
    }
  },
  "gamepad": {
    "movement": {
      "move": "left_stick",
      "crouch_down": "left_stick_down",
      "jump": "a"
    },
    "abilities": {
      "dash": "rb",
      "shadow_step": "lb",
      "grapple": "x",
      "ground_pound": "b",
      "air_dodge": "y",
      "time_slow": "left_trigger",
      "teleport": "right_trigger"
    },
    "combat": {
      "melee_attack": "x",
      "ranged_attack": "y",
      "special_attack": "b",
      "block_parry": "lb"
    },
    "ui": {
      "pause": "start",
      "inventory": "select",
      "map": "dpad_up",
      "quests": "dpad_left",
      "controls_help": "select+start"
    }
  },
  "display_names": {
    "space": "Space",
    "lshift": "Left Shift",
    "rshift": "Right Shift",
    "lctrl": "Left Ctrl",
    "rctrl": "Right Ctrl",
    "escape": "Esc",
    "tab": "Tab",
    "mouse1": "Left Click",
    "mouse2": "Right Click",
    "a": "A",
    "d": "D",
    "s": "S",
    "w": "W",
    "left": "←",
    "right": "→",
    "up": "↑",
    "down": "↓"
  }
}
